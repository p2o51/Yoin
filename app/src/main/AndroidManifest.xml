<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Failed artwork retries when the default network comes back (YoinApplication). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries><package android:name="com.apple.android.music" /></queries>

    <application
        android:name=".YoinApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.Yoin"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true">

        <activity android:name="com.apple.android.sdk.authentication.SDKUriHandlerActivity"
            android:exported="true" />
        <service android:name=".player.applemusic.AppleMusicPlaybackService"
            android:exported="false" android:foregroundServiceType="mediaPlayback">
            <intent-filter><action android:name="androidx.media3.session.MediaSessionService" /></intent-filter>
        </service>
        <service android:name=".player.applemusic.AppleMusicValidationService"
            android:exported="false" android:foregroundServiceType="mediaPlayback">
            <intent-filter><action android:name="androidx.media3.session.MediaSessionService" /></intent-filter>
        </service>
        <!-- Home-screen widgets (Glance). -->
        <receiver
            android:name=".widget.PlayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_play_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_play_info" />
        </receiver>
        <receiver
            android:name=".widget.MemoryWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_memory_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_memory_info" />
        </receiver>
        <activity
            android:name=".widget.WidgetPlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Yoin.WidgetTrampoline" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin.Splash"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Detail pages are separate Activities so back navigation plays the
          device-native cross-Activity predictive back animation. They inherit
          the application theme, are NOT exported (internal navigation only),
          and register no consuming back callback (back = finish()).
        -->
        <activity
            android:name=".ui.detail.AlbumDetailActivity"
            android:theme="@style/Theme.Yoin.DetailTranslucent"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.detail.ArtistDetailActivity"
            android:theme="@style/Theme.Yoin.DetailTranslucent"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.detail.PlaylistDetailActivity"
            android:theme="@style/Theme.Yoin.DetailTranslucent"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Settings' second level (add / manage a music service). Plain
             Activity on purpose: native cross-Activity predictive back. -->
        <activity
            android:name=".ui.settings.service.ServiceSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Settings list-detail 右栏的功能页（AI features / NeoDB），只从
             分栏里的 Settings 打开。Plain Activity：原生跨 Activity 返回。 -->
        <activity
            android:name=".ui.settings.SettingsFeatureActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Settings › Cloud sync (Google Drive appDataFolder). Plain Activity:
             native cross-Activity predictive back. -->
        <activity
            android:name=".ui.settings.sync.CloudSyncActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Settings list-detail 右栏占位面（tag="settings-placeholder" 的 SplitPlaceholderRule）。 -->
        <activity
            android:name=".ui.settings.SettingsPlaceholderActivity"
            android:exported="false" />
        <!-- The landing's floating guide over Spotify for Developers: picture-in-picture
             (no overlay permission), in its own task so the pinned window never drags
             the main task along. -->
        <activity
            android:name=".ui.landing.guide.ConnectGuideActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.connectguide"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" />

        <!-- Activity Embedding 开关：声明本应用的分栏由自己负责（规则见
             res/xml/main_split_config.xml，YoinApplication 里注册）。 -->
        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.gpo.yoin.player.CastOptionsProvider" />

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <activity
            android:name=".data.source.spotify.SpotifyOAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="yoin"
                    android:host="auth"
                    android:pathPrefix="/spotify/callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".data.source.spotify.SpotifyAppRemoteCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="yoin"
                    android:host="auth"
                    android:pathPrefix="/spotify/app-remote" />
            </intent-filter>
        </activity>

        <activity
            android:name=".data.integration.neodb.NeoDBOAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="yoin"
                    android:host="auth"
                    android:pathPrefix="/neodb/callback" />
            </intent-filter>
        </activity>

        <!-- Files handed to other apps via the share sheet (lyrics image card:
             ui/nowplaying/LyricsShareCard.kt, paths in res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
