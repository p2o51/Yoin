<?xml version="1.0" encoding="utf-8"?>
<!-- Shell → detail open when the bottom Button Group hands off to the
     mini-player dock: the incoming detail window FADES in (no slide) so the
     Compose-side pill morph inside it reads as stationary geometry. Duration
     must stay in step with detail_dock_handoff_exit. Close/back is never
     overridden — predictive back stays the system animation. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:fromAlpha="0.0"
    android:toAlpha="1.0"
    android:duration="240" />
