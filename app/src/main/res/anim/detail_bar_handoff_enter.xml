<?xml version="1.0" encoding="utf-8"?>
<!-- Shell → detail open: the incoming detail window stays fully TRANSPARENT
     for the first 200ms so the user watches the shell bar morph nav→split in
     place (tap-time feedback), then fades in over the near-settled morph onto
     its own pixel-identical bar. Pure alpha — any translate/scale would break
     the "one persistent bar" illusion. Paired with detail_bar_handoff_exit
     (shell holds opaque beneath for the full 380ms). -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="0.0"
    android:toAlpha="1.0"
    android:startOffset="200"
    android:duration="180"
    android:fillEnabled="true"
    android:fillBefore="true"
    android:interpolator="@android:interpolator/fast_out_slow_in" />
