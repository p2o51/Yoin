<?xml version="1.0" encoding="utf-8"?>
<!-- Detail Activity dissolving after a mini-player dock tap, revealing the
     shell mid NP-expansion. Slightly longer than the dock-handoff fade so the
     first half of the stage expansion shows through the dissolve. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:fromAlpha="1.0"
    android:toAlpha="0.0"
    android:duration="280" />
