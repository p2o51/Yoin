<?xml version="1.0" encoding="utf-8"?>
<!-- Detail close: the window dissolves IN PLACE (no translate/scale) so its
     bar stays pixel-aligned over the shell's identical bar — the bar reads
     as one fixed element while only the page content fades away. The shell
     then plays the split→nav reverse morph in full view. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="1.0"
    android:toAlpha="0.0"
    android:duration="220"
    android:interpolator="@android:interpolator/fast_out_slow_in" />
