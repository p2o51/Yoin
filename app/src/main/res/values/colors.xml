<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window background used only for the brief frames of the system
      cross-Activity predictive-back shrink (and cold start). Matched to the
      app's light surface so the area the system reveals around the shrinking
      page reads as a deliberate surface, not a black/grey gap.
      Dark variant lives in values-night/colors.xml.
    -->
    <color name="yoin_window_background">#FFFFFBFE</color>

    <!--
      Cold-start splash background (Theme.Yoin.Splash, API 31+). A near-black
      blue, matching the dark end of the Compose splash's primary-tinted radial
      so the system splash → bloom handoff is seamless. Always dark, so it is
      duplicated (not overridden) in values-night.
    -->
    <color name="yoin_splash_background">#FF06070F</color>
</resources>
