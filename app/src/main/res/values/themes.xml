<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      App window theme. Inherits the framework no-action-bar base but replaces
      the framework's opaque dark-grey windowBackground (#FF303030) with the
      app surface color so the system cross-Activity back animation reveals a
      matching surface instead of a black/grey margin around the shrinking page.

      windowBackground/colorBackground are DayNight-aware (values vs
      values-night). Edge-to-edge is preserved: the parent theme keeps
      windowDrawsSystemBarBackgrounds=true (so the window lays out BEHIND the
      system bars), and enableYoinEdgeToEdge() makes those bars transparent at
      runtime — so app content shows through the status/nav bar regions. The
      opaque windowBackground only fills the content region, never the bars.

      DO NOT add android:windowDrawsSystemBarBackgrounds=false here: it clears
      the flag that lets the window extend behind the bars, which collapses
      edge-to-edge and leaves the (dark) windowBackground showing as black
      bands in the top/bottom safe areas.
    -->
    <style name="Theme.Yoin" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/yoin_window_background</item>
        <item name="android:colorBackground">@color/yoin_window_background</item>
    </style>

    <!--
      Detail Activities: translucent-capable so the in-window predictive back
      can reveal the LIVE window beneath while the page collapses as a card
      (AOSP entering-target replication). It deliberately stays translucent:
      converting to opaque lets WM discard the shell surface, which leaves a
      black ring for several frames when a 1:1 back gesture reveals it before
      the shell can recreate and present a new buffer.
    -->
    <style name="Theme.Yoin.DetailTranslucent" parent="Theme.Yoin">
        <item name="android:windowIsTranslucent">true</item>
        <!-- Never let WM synthesize a stale/opaque starting preview while the
             real visual-ready page is intentionally being held transparent. -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <!--
      Launcher Activity theme = the cold-start SplashScreen (androidx
      core-splashscreen). The three-arrow bloom plays as the animated icon while
      the app loads (Gmail-style), then postSplashScreenTheme swaps to Theme.Yoin
      for the running app. Requires installSplashScreen() in MainActivity.

      The animated icon is brand-coloured (fixed) since the system splash can't
      read Material You — wallpaper adaptation lives in the in-app UI instead.
    -->
    <style name="Theme.Yoin.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/yoin_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_yoin_bloom</item>
        <item name="windowSplashScreenAnimationDuration">950</item>
        <item name="postSplashScreenTheme">@style/Theme.Yoin</item>
    </style>
</resources>
