    <string name="settings_feature_subsonic_playback_title">播放</string>
    <string name="settings_feature_subsonic_playback_body">在 Yoin 中自你的服务器串流，支持后台和系统播放控制。</string>
    <string name="settings_feature_subsonic_favorites_title">收藏</string>
    <string name="settings_feature_subsonic_favorites_body">心形标记会在你的服务器上收藏或取消收藏。</string>
    <string name="settings_feature_subsonic_playlists_title">歌单</string>
    <string name="settings_feature_subsonic_playlists_body">浏览并编辑可写的歌单。权限与可用操作取决于你的服务器。</string>
    <string name="settings_feature_subsonic_lyrics_title">歌词</string>
    <string name="settings_feature_subsonic_lyrics_body">优先使用服务器歌词，辅以 Yoin 补充歌词源。不保证完全匹配。</string>
    <string name="settings_feature_subsonic_ratings_title">评分与笔记</string>
    <string name="settings_feature_subsonic_ratings_body">按账号分别保存。曲目评分也会同步至支持评分的服务器。</string>
    <string name="settings_feature_subsonic_quality_title">音质</string>
    <string name="settings_feature_subsonic_quality_body">由你的服务器提供串流，可能会转码。原始文件格式不能代表当前输出。</string>
    <string name="settings_feature_subsonic_devices_title">设备与缓存</string>
    <string name="settings_feature_subsonic_devices_body">Yoin 支持投播和自动播放缓存。缓存并非可管理的离线下载库。</string>

    <string name="settings_feature_spotify_playback_title">播放</string>
    <string name="settings_feature_spotify_playback_body">需要 Spotify 应用与 Premium。音频与系统播放控制由 Spotify 负责，Yoin 远程控制播放。</string>
    <string name="settings_feature_spotify_saved_title">已保存的音乐</string>
    <string name="settings_feature_spotify_saved_body">心形标记会将歌曲加入或移出 Spotify 喜欢的歌曲。</string>
    <string name="settings_feature_spotify_playlists_title">歌单</string>
    <string name="settings_feature_spotify_playlists_body">浏览歌单，并编辑可写歌单。在 Yoin 中移除你的歌单会在 Spotify 上取消关注。</string>
    <string name="settings_feature_spotify_lyrics_title">歌词</string>
    <string name="settings_feature_spotify_lyrics_body">Yoin 使用补充歌词源。此集成无法获取 Spotify 官方歌词，匹配结果可能存在差异。</string>
    <string name="settings_feature_spotify_ratings_title">评分与笔记</string>
    <string name="settings_feature_spotify_ratings_body">按 Yoin 账号分别保存。评分不会同步至 Spotify。</string>
    <string name="settings_feature_spotify_quality_title">音质</string>
    <string name="settings_feature_spotify_quality_body">在 Spotify 中管理。Yoin 无法选择或确认当前串流的音质。</string>
    <string name="settings_feature_spotify_devices_title">设备与缓存</string>
    <string name="settings_feature_spotify_devices_body">播放目标使用 Spotify Connect。Yoin 的投播和音频缓存不适用于 Spotify，下载请在 Spotify 中管理。</string>

    <string name="settings_feature_apple_playback_title">播放</string>
    <string name="settings_feature_apple_playback_body">MusicKit 在 Yoin 中播放目录歌曲，支持后台与系统控制。无目录匹配的导入歌曲需在 Apple Music 中播放。</string>
    <string name="settings_feature_apple_library_title">资料库与搜索</string>
    <string name="settings_feature_apple_library_body">浏览资料库中的歌曲、专辑、艺术家和歌单。可搜索你的资料库或 Apple Music 目录。</string>
    <string name="settings_feature_apple_add_title">加入资料库</string>
    <string name="settings_feature_apple_add_body">将目录歌曲加入你的资料库。Yoin 确认已加入后才显示对勾。资料库收录与收藏是两回事。</string>
    <string name="settings_feature_apple_playlists_title">歌单</string>
    <string name="settings_feature_apple_playlists_body">浏览并播放歌单。编辑请前往 Apple Music。</string>
    <string name="settings_feature_apple_lyrics_title">歌词、评分与笔记</string>
    <string name="settings_feature_apple_lyrics_body">Yoin 的补充歌词源、本地评分与笔记。不含 Apple 官方歌词。</string>
    <string name="settings_feature_apple_quality_title">音质</string>
    <string name="settings_feature_apple_quality_body">串流由 MusicKit 管理。Yoin 无法确认无损或空间音频输出。</string>
    <string name="settings_feature_apple_offline_title">离线与设备</string>
    <string name="settings_feature_apple_offline_body">Apple Music 无法使用 Yoin 的投播和音频缓存。</string>

    <string name="settings_feature_local_library_title">本地资料库</string>
    <string name="settings_feature_local_library_body">Yoin 暂未支持浏览或导入本地文件。</string>
    <string name="settings_feature_unknown_title">服务功能</string>
    <string name="settings_feature_unknown_body">暂无此服务已验证的功能信息。</string>

