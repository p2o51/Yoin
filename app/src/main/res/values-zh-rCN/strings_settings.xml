    <string name="settings_feature_subsonic_playback_title">播放</string>
    <string name="settings_feature_subsonic_playback_body">在 Yoin 里从你的服务器串流，支持后台和系统播放控制。</string>
    <string name="settings_feature_subsonic_favorites_title">收藏</string>
    <string name="settings_feature_subsonic_favorites_body">心形标记会在你的服务器上收藏或取消收藏。</string>
    <string name="settings_feature_subsonic_playlists_title">播放列表</string>
    <string name="settings_feature_subsonic_playlists_body">浏览并编辑可写的播放列表。权限和可用操作取决于你的服务器。</string>
    <string name="settings_feature_subsonic_lyrics_title">歌词</string>
    <string name="settings_feature_subsonic_lyrics_body">有服务器歌词时使用，也会用 Yoin 的其他歌词来源。不保证能匹配上。</string>
    <string name="settings_feature_subsonic_ratings_title">评分和笔记</string>
    <string name="settings_feature_subsonic_ratings_body">按账号分别保存。歌曲评分也会同步到支持评分的服务器。</string>
    <string name="settings_feature_subsonic_quality_title">音质</string>
    <string name="settings_feature_subsonic_quality_body">由你的服务器提供串流，可能会转码。原始文件格式不能说明当前输出。</string>
    <string name="settings_feature_subsonic_devices_title">设备和缓存</string>
    <string name="settings_feature_subsonic_devices_body">Yoin 支持 Cast 和自动播放缓存。缓存不是可管理的离线下载库。</string>

    <string name="settings_feature_spotify_playback_title">播放</string>
    <string name="settings_feature_spotify_playback_body">需要 Spotify 应用和 Premium。音频和系统播放控制由 Spotify 负责，Yoin 远程控制播放。</string>
    <string name="settings_feature_spotify_saved_title">已保存的音乐</string>
    <string name="settings_feature_spotify_saved_body">心形标记会把歌曲加入或移出 Spotify 喜欢的歌曲。</string>
    <string name="settings_feature_spotify_playlists_title">播放列表</string>
    <string name="settings_feature_spotify_playlists_body">浏览播放列表，并编辑你能修改的那些。在 Yoin 里移除你的播放列表，会在 Spotify 上取消关注。</string>
    <string name="settings_feature_spotify_lyrics_title">歌词</string>
    <string name="settings_feature_spotify_lyrics_body">Yoin 使用其他歌词来源。此集成无法使用 Spotify 官方歌词，匹配结果可能不同。</string>
    <string name="settings_feature_spotify_ratings_title">评分和笔记</string>
    <string name="settings_feature_spotify_ratings_body">按 Yoin 账号分别保存。评分不会同步到 Spotify。</string>
    <string name="settings_feature_spotify_quality_title">音质</string>
    <string name="settings_feature_spotify_quality_body">在 Spotify 中管理。Yoin 无法选择或确认当前串流的音质。</string>
    <string name="settings_feature_spotify_devices_title">设备和缓存</string>
    <string name="settings_feature_spotify_devices_body">播放目标用 Spotify Connect。Yoin 的 Cast 和音频缓存不适用于 Spotify，下载请在 Spotify 中管理。</string>

    <string name="settings_feature_apple_playback_title">播放</string>
    <string name="settings_feature_apple_playback_body">MusicKit 在 Yoin 里播放目录歌曲，支持后台和系统控制。没有目录匹配的导入歌曲需要在 Apple Music 中播放。</string>
    <!-- REVIEW: 候选：资料库 | 音乐库 | 库 -->
    <string name="settings_feature_apple_library_title">资料库和搜索</string>
    <!-- REVIEW: 候选：资料库 | 音乐库 | 库 -->
    <string name="settings_feature_apple_library_body">浏览资料库中的歌曲、专辑、艺人和播放列表。可搜索你的资料库或 Apple Music 目录。</string>
    <!-- REVIEW: 候选：资料库 | 音乐库 | 库 -->
    <string name="settings_feature_apple_add_title">加入资料库</string>
    <string name="settings_feature_apple_add_body">把目录歌曲加入你的资料库。Yoin 确认已加入后才显示对勾。资料库成员和收藏是两回事。</string>
    <string name="settings_feature_apple_playlists_title">播放列表</string>
    <string name="settings_feature_apple_playlists_body">浏览并播放播放列表。编辑请到 Apple Music。</string>
    <string name="settings_feature_apple_lyrics_title">歌词、评分和笔记</string>
    <string name="settings_feature_apple_lyrics_body">Yoin 的其他歌词来源、本地评分和笔记。不含 Apple 官方歌词。</string>
    <string name="settings_feature_apple_quality_title">音质</string>
    <string name="settings_feature_apple_quality_body">串流由 MusicKit 管理。Yoin 不确认无损或空间音频输出。</string>
    <string name="settings_feature_apple_offline_title">离线和设备</string>
    <string name="settings_feature_apple_offline_body">Apple Music 无法使用 Yoin 的 Cast 和音频缓存。</string>

