<?xml version="1.0" encoding="utf-8"?>
<!--
  Cold-start bloom: the three arrows spring in from the centre (scale 0 → 0.8 +
  rotate -150° → 0°, OvershootInterpolator ≈ a spring). All three start together
  but settle at slightly different durations for an organic feel without the
  staggered-start flicker an AnimatedVectorDrawable would otherwise show. Plays
  once as the SplashScreen animated icon, then holds the assembled mark until
  the first app frame is ready. See splash_yoin_mark.xml for the artwork.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_yoin_mark">
    <target android:name="armT">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="0.8"
                    android:duration="920"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="0.8"
                    android:duration="920"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-150"
                    android:valueTo="0"
                    android:duration="920"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="armP">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="0.8"
                    android:duration="760"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="0.8"
                    android:duration="760"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-150"
                    android:valueTo="0"
                    android:duration="760"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="armS">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="0.8"
                    android:duration="840"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="0.8"
                    android:duration="840"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-150"
                    android:valueTo="0"
                    android:duration="840"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
