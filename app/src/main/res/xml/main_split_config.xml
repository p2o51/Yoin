<!--
  Activity Embedding — Settings list-detail ONLY.

  - shell ↔ detail 不再走 Activity Embedding（2026-10-02，适配原则 3「分栏是
    同一窗口里的列」）：≥ 840 且高 ≥ 480 的整窗里，详情页是 shell 自己窗口
    里的右列（ui/navigation/pane），一条底栏横跨两列、分隔条是 app 自己的
    M3 拖动把手。shell-detail / shell-settings 两条规则连同它们的 calculator
    分支一起删掉；Settings 从 shell 启动时自然整窗。
  - Settings → 账号二级页是 list-detail（tag="settings-*"，SettingsTablet）：
    左 Settings、右 ServiceSetup，无选中时右栏是占位页。只在窗口 ≥ 840dp
    激活。比例由 YoinApplication 的 SplitAttributesCalculator 按窗宽算
    （列表约 420dp，至少三分之一）；0.33 是 WindowSdkExtensions < 2 的回退值。
-->
<resources xmlns:window="http://schemas.android.com/apk/res-auto">
    <!-- Settings list-detail：选中账号的二级页开在右栏，clearTop 让换账号
         替换右栏而不是叠一层。Settings 自己不 alwaysExpand —— 那样它永远
         不参与分栏，list-detail 就做不成了（断点交接 §7）。 -->
    <SplitPlaceholderRule
        window:tag="settings-placeholder"
        window:placeholderActivityName="com.gpo.yoin.ui.settings.SettingsPlaceholderActivity"
        window:splitRatio="0.33"
        window:splitMinWidthDp="840"
        window:stickyPlaceholder="false">
        <ActivityFilter window:activityName="com.gpo.yoin.ui.settings.SettingsActivity" />
    </SplitPlaceholderRule>

    <SplitPairRule
        window:tag="settings-setup"
        window:splitRatio="0.33"
        window:splitMinWidthDp="840"
        window:clearTop="true"
        window:finishPrimaryWithSecondary="never"
        window:finishSecondaryWithPrimary="always">
        <SplitPairFilter
            window:primaryActivityName="com.gpo.yoin.ui.settings.SettingsActivity"
            window:secondaryActivityName="com.gpo.yoin.ui.settings.service.ServiceSetupActivity" />
        <SplitPairFilter
            window:primaryActivityName="com.gpo.yoin.ui.settings.SettingsActivity"
            window:secondaryActivityName="com.gpo.yoin.ui.settings.SettingsFeatureActivity" />
        <SplitPairFilter
            window:primaryActivityName="com.gpo.yoin.ui.settings.SettingsActivity"
            window:secondaryActivityName="com.gpo.yoin.ui.settings.sync.CloudSyncActivity" />
    </SplitPairRule>
</resources>
