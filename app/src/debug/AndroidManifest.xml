<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- debug 专属：把 AlbumDetailActivity 放开成 exported，让 adb 能直接
             以独立窗口启动它（Compact / Medium / 矮窗的推入页；fake id →
             加载失败态）。Wide 窗口的详情是 shell 里的列、不是 Activity，
             adb 触发不了（见 debug/README.md）。release manifest 里保持
             exported=false。 -->
        <activity
            android:name="com.gpo.yoin.ui.detail.AlbumDetailActivity"
            android:exported="true"
            tools:node="merge"
            tools:replace="android:exported" />
        <activity
            android:name=".debug.DetailScreenshotActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.MemoriesScreenshotActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.MemoryCardScreenshotActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.LibraryScreenshotActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.AuroraPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.ShadowReturnAuditActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.LyricsMotionPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.SettingsPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.MemoriesEmptyPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.BarMorphPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <activity
            android:name=".debug.MotionAuditActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoin" />
        <provider
            android:name=".debug.SpotifyTokenExportProvider"
            android:authorities="${applicationId}.debug.spotifytoken"
            android:exported="true"
            android:readPermission="android.permission.DUMP" />
        <!-- 只读的 App Remote 收藏状态探针（Q17）：adb 发广播，结果打到 logcat 的 YoinProbe。
             只有持 DUMP 的 shell 能发；不起播、不改队列。用法见 docs/perf/yoinperf-logging.md。 -->
        <receiver
            android:name=".debug.LibraryStateProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.gpo.yoin.debug.LIBRARY_STATE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
