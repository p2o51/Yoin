   "notes": [
    {
     "track": 1,
     "at": 8,
     "date": "2025-11-09",
     "text": "钢琴慢到我以为播放器卡住了。"
    },
    {
     "track": 1,
     "at": 102,
     "date": "2026-01-14",
     "text": "原来那是留给呼吸的空白。"
    },
    {
     "track": 2,
     "at": 31,
     "date": "2025-11-21",
     "text": "鼓压着拍子走，像踩在冰面上。"
    },
    {
     "track": 2,
     "at": 130,
     "date": "2025-12-03",
     "text": "这里贝斯终于敢用力了。"
    },
    {
     "track": 2,
     "at": null,
     "date": "2025-11-15",
     "text": "整首都像屏着一口气。"
    },
    {
     "track": 10,
     "at": null,
     "date": "2026-02-10",
     "text": "太短了，刚进入状态就结束。"
    },
    {
     "track": 3,
     "at": 65,
     "date": "2025-11-12",
     "text": "下班的夜路，路灯每隔二十步一盏。"
    },
    {
     "track": 6,
     "at": 47,
     "date": "2026-02-02",
     "text": "呵气在玻璃上画了个圈。"
    },
    {
     "track": 7,
     "at": 118,
     "date": "2026-01-20",
     "text": "合唱进来那一下，地铁上没忍住。"
    },
    {
     "track": 7,
     "at": 220,
     "date": "2026-03-08",
     "text": "第二遍合唱压低了半度，像天快亮了。"
    },
    {
     "track": 7,
     "at": 295,
     "date": "2026-06-30",
     "text": "夏天再听，它不冷了。"
    },
    {
     "track": 9,
     "at": 20,
     "date": "2026-04-02",
     "text": "解冻是从屋檐开始的。"
    },
    {
     "track": 9,
     "at": 192,
     "date": "2026-04-19",
     "text": "弦乐把整张专辑托起来了，这一首可以单独拿出来听很多遍。"
    },
    {
     "track": 12,
     "at": 330,
     "date": "2026-09-20",
     "text": "以前总跳过这段环境声，今天等它放完了。"
    },
    {
     "track": null,
     "at": null,
     "date": "2026-09-12",
     "text": "适合一个人走很长的路。"
    }
   ]
