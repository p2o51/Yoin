      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched by ISRC first, then by title, artist, and duration. You check the unsure ones; tracks not found stay in %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先按 ISRC 匹配，其次按歌名、艺人与时长；待确认项由你核对，未匹配项保留在 %1$@。"
          }
        }
      }
    },
    "settings_xfer_method_partial": {
      "comment": "Android R.string.settings_xfer_method_partial",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostly direct, the rest matched"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大部分直接复制，其余需匹配"
          }
        }
      }
    },
    "settings_xfer_method_partial_summary": {
      "comment": "Android R.string.settings_xfer_method_partial_summary",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalog tracks copy directly; tracks private to the original library are matched again by title and artist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录曲目直接复制；仅限原资料库的私有曲目将按歌名与艺人重新匹配。"
          }
        }
      }
    },
    "settings_xfer_neodb_note": {
      "comment": "Android R.string.settings_xfer_neodb_note",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied ratings aren't pushed to NeoDB again, and running it again skips what was already copied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的评分不会重复推送至 NeoDB，再次运行会自动跳过已复制项。"
          }
        }
      }
    },
