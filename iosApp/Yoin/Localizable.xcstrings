      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复同步"
          }
        }
      }
    },
    "Saved in your private iCloud database (CloudKit) across your Apple devices. Protected by your Apple Account and counts toward your iCloud storage.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在你自己的 iCloud 私有数据库（CloudKit）中，在你的 Apple 设备间同步。受 Apple 账号保护，并计入你的 iCloud 存储空间。"
          }
        }
      }
    },
    "Google Drive isn't configured in this build of Yoin.": {
      "localizations": {
        "zh-Hans": {
