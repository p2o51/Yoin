{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "Help and about": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助与关于"
          }
        }
      }
    },
    "Sync and storage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步与存储"
          }
        }
      }
    },
    "— %@": {},
    ", %lld of them rated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，其中 %lld 首打了分"
          }
        }
      }
    },
    ", every one of them rated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，每一首都打了分"
          }
        }
      }
    },
    "“%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        }
      }
    },
    "“%@” by %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” by %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "《%1$@》%2$@"
          }
        }
      }
    },
    "“%@” is now signed in as a different account. Notes and ratings it synced before are removed from this device, and it syncs as the new account from now on. Your Drive and your other devices keep the old ones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”现在登录了另一个账号。此前同步的笔记与评分将从此设备移除，后续将作为新账号同步。你的 Drive 与其他设备仍保留旧数据。"
          }
        }
      }
    },
    "“%@” will be removed from Yoin. Your ratings, notes and history stay.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将从 Yoin 中移除。你的评分、笔记与播放记录会保留。"
          }
        }
      }
    },
    "\"%@\" will be removed from your library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将从你的资料库中移除。"
          }
        }
      }
    },
